# Copiá este archivo a `keystore.properties` (en la raíz del proyecto) y completá
# tus datos para poder firmar el APK de release LOCALMENTE.
#
# IMPORTANTE: `keystore.properties` y los archivos .keystore/.jks están en
# .gitignore y NUNCA deben subirse al repositorio.
#
# Para generar un keystore nuevo:
#   keytool -genkey -v -keystore mi-release.keystore -alias mi-alias \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Luego apuntá storeFile a ese archivo (ruta relativa al módulo app/).

storeFile=../mi-release.keystore
storePassword=CAMBIA_ESTO
keyAlias=mi-alias
keyPassword=CAMBIA_ESTO
